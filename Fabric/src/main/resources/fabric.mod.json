{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Hidoni/CustomizableElytra"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hidoni.customizableelytra.CustomizableElytraFabric"
    ],
    "client": [
      "com.hidoni.customizableelytra.CustomizableElytraFabricClient"
    ]
  },
  "mixins": [
    "mixins.customizableelytra.common.json",
    "mixins.customizableelytra.fabric.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_semver_range}",
    "java": ">=${java_version}"
  },
  "accessWidener": "${mod_id}.accesswidener"
}
  